{
	"name": "apolovyi-web",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"prebuild": "npm run validate:dictionaries",
		"build": "next build",
		"analyze": "ANALYZE=true next build",
		"format": "prettier \"**/*.{css,js,json,jsx,ts,tsx}\"",
		"format:write": "prettier --write \"**/*.{css,js,json,jsx,ts,tsx}\"",
		"format:check": "prettier --check \"**/*.{css,js,json,jsx,ts,tsx}\"",
		"start": "next start",
		"generate-placeholders": "node scripts/generatePlaceholders.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:ci": "eslint . --max-warnings=0",
		"validate:dictionaries": "node scripts/validateDictionaries.js",
		"check": "npm run format:check && npm run lint:ci",
		"prepare": "husky",
		"test:smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@react-three/drei": "^10.7.7",
		"@react-three/fiber": "^9.4.2",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"dotted-map": "^2.2.3",
		"lenis": "^1.3.11",
		"motion": "^12.23.19",
		"next": "^15.5.3",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"tailwind-merge": "^2.5.2",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.182.0",
		"three-globe": "^2.45.0",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.36.0",
		"@next/bundle-analyzer": "^15.5.3",
		"@tailwindcss/typography": "~0.5.14",
		"@trivago/prettier-plugin-sort-imports": "^4.3.0",
		"@types/node": "~22.3.0",
		"@types/react": "^19.1.13",
		"@types/react-dom": "^19.1.9",
		"autoprefixer": "~10.4.20",
		"eslint": "^9.36.0",
		"eslint-config-next": "^15.5.3",
		"eslint-config-prettier": "~9.1.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"sharp": "^0.34.5",
		"tailwindcss": "~3.4.19",
		"typescript": "~5.9.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,md,json}": [
			"prettier --write"
		],
		"dictionaries/*.json": [
			"npm run validate:dictionaries"
		]
	}
}
