#!/bin/sh
set -e

# Silence Node Experimental warnings during LHCI runs
export NODE_OPTIONS=--no-warnings
# Ensure our LH gating is active for consistent runs
export NEXT_PUBLIC_LIGHTHOUSE=true

# Desktop: collect -> print summary -> assert
rm -rf .lighthouseci || true
npx @lhci/cli collect --config=./lighthouserc.desktop.json || (node scripts/print-lhci-summary.mjs; exit 1)
node scripts/print-lhci-summary.mjs
npx @lhci/cli assert --config=./lighthouserc.desktop.json

# Mobile: collect -> print summary -> assert
rm -rf .lighthouseci || true
npx @lhci/cli collect --config=./lighthouserc.mobile.json || (node scripts/print-lhci-summary.mjs; exit 1)
node scripts/print-lhci-summary.mjs
npx @lhci/cli assert --config=./lighthouserc.mobile.json

