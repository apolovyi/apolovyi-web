{
	"ci": {
		"collect": {
			"startServerCommand": "npm run build && node scripts/static-server.mjs",
			"startServerReadyPattern": "STATIC_SERVER_READY",
			"startServerReadyTimeout": 180000,
			"url": [
				"http://localhost:4173/"
			],
			"numberOfRuns": 3,
			"settings": {
				"formFactor": "mobile",
				"screenEmulation": {
					"mobile": true
				}
			}
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.8
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.8
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.8
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 0.8
					}
				]
			}
		}
	}
}
