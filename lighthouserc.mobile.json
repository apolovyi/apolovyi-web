{
	"ci": {
		"collect": {
			"startServerCommand": "npm run build && node scripts/static-server.mjs",
			"startServerReadyPattern": "STATIC_SERVER_READY",
			"url": [
				"http://localhost:4173/"
			],
			"numberOfRuns": 1,
			"settings": {
				"preset": "mobile"
			}
		},
		"assert": {
			"assertions": {
				"categories:performance": [
					"error",
					{
						"minScore": 0.99
					}
				],
				"categories:accessibility": [
					"error",
					{
						"minScore": 0.99
					}
				],
				"categories:best-practices": [
					"error",
					{
						"minScore": 0.99
					}
				],
				"categories:seo": [
					"error",
					{
						"minScore": 0.99
					}
				]
			}
		}
	}
}
